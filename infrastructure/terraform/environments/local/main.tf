# Local environment: open-source services standing in for managed cloud ones.
#
#   terraform init && terraform apply
#
# Provisions PostgreSQL, Redis and LocalStack, creates the bucket layout,
# access policy, CORS and lifecycle rules from docs/33_Bucket_Structure.md,
# then renders the application's .env files from the stack outputs.
#
# The `aws` provider below is the only local-specific part: it points at
# LocalStack instead of AWS. modules/storage-s3 is applied unchanged in
# ../aws, which is what keeps local and cloud from drifting.

terraform {
  required_version = ">= 1.6"

  required_providers {
    docker = { source = "kreuzwerker/docker", version = "~> 3.0" }
    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
    local  = { source = "hashicorp/local", version = "~> 2.4" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
}

provider "docker" {
  host = var.docker_host
}

provider "aws" {
  region     = var.storage_region
  access_key = var.storage_access_key
  secret_key = var.storage_secret_key

  # LocalStack is not a real account: skip the checks that would reach out to
  # AWS metadata and STS endpoints.
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true
  s3_use_path_style           = true

  endpoints {
    s3 = "http://localhost:${var.host_port_storage_api}"
  }
}

# Dev-only JWT secret. docs/17_Security.md requires 32+ characters; a real
# environment injects this from a secret manager instead.
resource "random_password" "jwt_secret" {
  length  = 64
  special = false
}

module "stack" {
  source = "../../modules/local-stack"

  project     = var.project
  environment = "local"

  db_username        = var.db_username
  db_password        = var.db_password
  storage_access_key = var.storage_access_key
  storage_secret_key = var.storage_secret_key
  storage_region     = var.storage_region
  allowed_origins    = var.media_allowed_origins

  host_port_postgres    = var.host_port_postgres
  host_port_redis       = var.host_port_redis
  host_port_storage_api = var.host_port_storage_api
}

# --- Rendered application configuration -------------------------------------
locals {
  repo_root = abspath("${path.module}/../../../..")

  # Shared by both perspectives; only the service URLs differ.
  common_env = <<-EOT
    # Generated by infrastructure/terraform/environments/local. Do not edit.
    # Re-run `terraform apply` to regenerate.

    NODE_ENV=development
    APP_NAME=${var.project}
    APP_URL=http://localhost:3000
    API_URL=http://localhost:3001
    PORT=3001

    DATABASE_POOL_SIZE=10

    JWT_SECRET=${random_password.jwt_secret.result}
    JWT_EXPIRES_IN=15m
    JWT_REFRESH_EXPIRES_IN=7d
    BCRYPT_COST=12

    S3_REGION=${module.stack.storage_region}
    S3_ACCESS_KEY=${module.stack.storage_access_key}
    S3_SECRET_KEY=${nonsensitive(module.stack.storage_secret_key)}
    S3_BUCKET=${module.stack.storage_bucket}
    S3_FORCE_PATH_STYLE=${module.stack.storage_force_path_style}

    FFMPEG_PATH=/usr/bin/ffmpeg
    FFPROBE_PATH=/usr/bin/ffprobe

    LOG_LEVEL=debug
    RATE_LIMIT_WINDOW_MS=60000
    RATE_LIMIT_MAX=100

    NEXT_PUBLIC_API_URL=http://localhost:3001
    NEXT_PUBLIC_MEDIA_BASE_URL=${module.stack.storage_public_base_url}
  EOT
}

# Host perspective: backend and frontend run with `npm run dev` on the host.
resource "local_file" "env_host" {
  filename        = "${local.repo_root}/.env"
  file_permission = "0600"

  content = <<-EOT
    ${local.common_env}
    DATABASE_URL=${nonsensitive(module.stack.database_url)}
    REDIS_URL=${module.stack.redis_url}
    S3_ENDPOINT=${module.stack.storage_endpoint}
  EOT
}

# Next.js reads .env.local from its own directory and inlines NEXT_PUBLIC_*
# at build time. It is written separately, without NODE_ENV: a NODE_ENV of
# "development" leaking into `next build` makes it prerender the dev-only
# error pages and fail.
resource "local_file" "env_frontend" {
  filename        = "${local.repo_root}/frontend/.env.local"
  file_permission = "0600"

  content = <<-EOT
    # Generated by infrastructure/terraform/environments/local. Do not edit.
    NEXT_PUBLIC_API_URL=http://localhost:3001
    NEXT_PUBLIC_MEDIA_BASE_URL=${module.stack.storage_public_base_url}
  EOT
}

# Container perspective: the worker image carries ffmpeg and joins the stack
# network, so it addresses services by alias.
resource "local_file" "env_docker" {
  filename        = "${local.repo_root}/.env.docker"
  file_permission = "0600"

  content = <<-EOT
    ${local.common_env}
    DATABASE_URL=${nonsensitive(module.stack.database_url_internal)}
    REDIS_URL=${module.stack.redis_url_internal}
    S3_ENDPOINT=${module.stack.storage_endpoint_internal}
    PLATFORM_NETWORK=${module.stack.network_name}
  EOT
}
