# Copy to prod.tfvars and fill in. Never commit real values.
region                 = "eu-west-1"
environment            = "prod"
vpc_id                 = "vpc-0123456789abcdef0"
private_subnet_ids     = ["subnet-0aaa...", "subnet-0bbb..."]
app_security_group_ids = ["sg-0ccc..."]
allowed_origins        = ["https://app.example.com"]

# Supply via TF_VAR_db_password from a secret manager rather than a file.
# db_password = "..."
