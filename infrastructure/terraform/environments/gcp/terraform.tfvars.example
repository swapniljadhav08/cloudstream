# Copy to dev.tfvars and adjust. Never commit real values.
project_id      = "devcartel-8aa92"
environment     = "dev"
region          = "europe-west1"
allowed_origins = ["http://localhost:3000"]

# Cheapest tiers for a first apply; raise them for anything real.
db_tier         = "db-f1-micro"
cache_memory_gb = 1

# Supply the password out of band:
#   export TF_VAR_db_password="$(openssl rand -base64 24)"
