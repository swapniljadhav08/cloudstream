// Schema transcribed from docs/07_Database_Schema.md.
// Entity set, field names, defaults, indexes and @@map names follow that
// document; see docs/diagrams/ER_Diagram.md for the relationship overview.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(USER)
  avatarUrl     String?
  storageUsed   BigInt    @default(0)
  storageQuota  BigInt    @default(10737418240)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  videos        Video[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Video {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  status      VideoStatus @default(PENDING)
  originalUrl String
  duration    Int?
  fileSize    BigInt
  mimeType    String
  metadata    Json?
  isPublic    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolutions    VideoResolution[]
  thumbnails     Thumbnail[]
  processingJobs ProcessingJob[]
  progress       VideoProgress?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("videos")
}

model VideoResolution {
  id         String @id @default(cuid())
  videoId    String
  resolution String
  url        String
  bitrate    Int
  width      Int
  height     Int

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, resolution])
  @@index([videoId])
  @@index([resolution])
  @@map("video_resolutions")
}

model Thumbnail {
  id        String @id @default(cuid())
  videoId   String
  url       String
  timestamp Int
  width     Int
  height    Int

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("thumbnails")
}

model ProcessingJob {
  id           String    @id @default(cuid())
  videoId      String
  status       JobStatus @default(PENDING)
  progress     Int       @default(0)
  priority     Int       @default(0)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
  @@index([priority])
  @@map("processing_jobs")
}

model VideoProgress {
  id        String   @id @default(cuid())
  videoId   String   @unique
  userId    String
  position  Int
  duration  Int
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, userId])
  @@map("video_progress")
}

model StorageQuota {
  id          String   @id @default(cuid())
  userId      String   @unique
  used        BigInt   @default(0)
  quota       BigInt
  warningSent Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("storage_quotas")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
