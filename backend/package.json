{
  "name": "@video-streaming/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -r ts-node/register/transpile-only --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node -r ts-node/register/transpile-only --env-file=.env prisma/seed.ts",
    "test": "node -r ts-node/register/transpile-only --test test/unit.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@aws-sdk/lib-storage": "^3.726.0",
    "@aws-sdk/s3-request-presigner": "^3.726.0",
    "@fastify/multipart": "^9.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "@video-streaming/shared": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
